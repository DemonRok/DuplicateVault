<Window x:Class="DuplicateVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DuplicateVault" Icon="Assets/DuplicateVault.ico" Height="760" Width="1180" MinHeight="620" MinWidth="980"
        Background="#F4F7FB" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#122033" />
    <SolidColorBrush x:Key="Muted" Color="#64748B" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Line" Color="#D8E0EA" />
    <SolidColorBrush x:Key="Primary" Color="#00A9C8" />
    <SolidColorBrush x:Key="PrimaryDark" Color="#075C74" />

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#122033" />
      <Setter Property="Background" Value="#E7EEF6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#D5E3F1" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45" />
          <Setter Property="Cursor" Value="Arrow" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Primary}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="RowHeaderWidth" Value="0" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7" />
      <Setter Property="Background" Value="White" />
      <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#EEF4FA" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="BorderBrush" Value="#D8E0EA" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="310" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="#102033">
      <Grid Margin="22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <Image Source="Assets/DuplicateVault.png" Width="178" Height="118" Stretch="Uniform" HorizontalAlignment="Left" />
          <TextBlock Text="DuplicateVault" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,0" />
          <TextBlock Text="{Binding VersionText}" Foreground="#9FB4C9" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#172B42" CornerRadius="8" Padding="14" Margin="0,24,0,16">
          <StackPanel>
            <TextBlock Text="Radici scansione" Foreground="White" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Aggiungi cartelle o dischi NTFS da confrontare." Foreground="#A8B8C8" TextWrapping="Wrap" Margin="0,5,0,12" />
            <Button Content="Scegli cartella" Command="{Binding AddRootCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="Rimuovi selezione" Command="{Binding RemoveRootCommand}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}" Background="#0B1726" Foreground="#E6F0FA"
                 BorderBrush="#28425F" BorderThickness="1" Padding="6">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Symbol}" Foreground="#7DD3FC" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="#E6F0FA" />
                  <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Foreground="#9FB4C9" FontSize="11" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
          <TextBlock Text="Data root" Foreground="#9FB4C9" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DataRoot}" Foreground="#CFDCEA" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="26">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Analisi duplicati" Foreground="{StaticResource Ink}" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Text="Trova copie fisiche identiche e trasformale in hard link NTFS verificati." Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Configurazione" Command="{Binding SettingsCommand}" />
          <Button Content="Annulla" Command="{Binding CancelScanCommand}" Margin="8,0,0,0" />
          <Button Content="Scansione pulita" Command="{Binding StartCleanScanCommand}" Margin="8,0,0,0" />
          <Button Content="Avvia scansione" Command="{Binding StartScanCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>

      <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,14">
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
          <StackPanel>
            <TextBlock Text="Gruppi duplicati" Foreground="{StaticResource Muted}" />
            <TextBlock Text="{Binding GroupCountText}" Foreground="{StaticResource Ink}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,6,0">
          <StackPanel>
            <TextBlock Text="Spazio recuperabile" Foreground="{StaticResource Muted}" />
            <TextBlock Text="{Binding ReclaimableText}" Foreground="{StaticResource PrimaryDark}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="12,0,0,0">
          <StackPanel>
            <TextBlock Text="File inclusi" Foreground="{StaticResource Muted}" />
            <TextBlock Text="{Binding IncludedFilesText}" Foreground="{StaticResource Ink}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ProgressActivity}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="1" Background="#E6F7FB" CornerRadius="6" Padding="10,3" Margin="16,0,0,0" MinWidth="58">
              <TextBlock Text="{Binding ProgressPercentText}" Foreground="{StaticResource PrimaryDark}" FontWeight="SemiBold" TextAlignment="Center" />
            </Border>
          </Grid>
          <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,9,0,9">
            <TextBlock Text="{Binding ProgressPath}" Foreground="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="520" />
            </Grid.ColumnDefinitions>
            <ProgressBar Height="16" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
            <TextBlock Grid.Column="1" Text="{Binding ProgressCounters}" Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Gruppi trovati" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding DuplicateGroups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding Files.Count}" Width="70" />
                <DataGridTextColumn Header="Dimensione" Binding="{Binding LengthText}" Width="110" />
                <DataGridTextColumn Header="Recuperabile" Binding="{Binding ReclaimableText}" Width="120" />
                <DataGridTextColumn Header="Hash" Binding="{Binding FullHash}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="File del gruppo" Foreground="{StaticResource Ink}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedFiles}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Master" Width="70">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <RadioButton IsChecked="{Binding IsMasterCandidate, Mode=OneWay}"
                                   Command="{Binding DataContext.SetMasterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                   CommandParameter="{Binding}"
                                   HorizontalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="Da collegare" Binding="{Binding IsPlannedLink, Mode=OneWay}" Width="105" />
                <DataGridCheckBoxColumn Header="Già link" Binding="{Binding IsExistingHardLink, Mode=OneWay}" Width="75" />
                <DataGridCheckBoxColumn Header="Disponibile" Binding="{Binding IsAvailable, Mode=OneWay}" Width="90" />
                <DataGridTextColumn Header="Dimensione" Binding="{Binding LengthText}" Width="105" />
                <DataGridTextColumn Header="Percorso" Binding="{Binding Record.FullPath}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="4" Background="#EAF1F8" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Dry run" Command="{Binding DryRunCommand}" />
            <Button Content="Esegui hard link" Command="{Binding ExecuteHardLinkCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
          </StackPanel>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" Fill="{StaticResource Primary}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" Margin="0,4,12,0" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
